# ===========================================
# WhatsApp AI Assistant - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=WhatsApp AI Assistant
DEBUG=false

# ===========================================
# Database Configuration (Railway PostgreSQL)
# ===========================================
POSTGRES_SERVER=your_railway_postgres_host
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=railway
POSTGRES_PORT=5432
# Or use DATABASE_URL directly from Railway:
# DATABASE_URL=postgresql://user:pass@host:port/db

# ===========================================
# Redis Configuration (Railway Redis)
# ===========================================
REDIS_HOST=your_railway_redis_host
REDIS_PORT=6379
REDIS_DB=0
# Or use REDIS_URL directly from Railway:
# REDIS_URL=redis://host:port

# ===========================================
# Twilio WhatsApp API
# Get from: https://console.twilio.com/
# ===========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
WHATSAPP_WEBHOOK_URL=https://your-railway-app.up.railway.app/api/v1/webhook/whatsapp

# ===========================================
# Google Gemini AI
# Get from: https://aistudio.google.com/app/apikey
# ===========================================
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=40000

# ===========================================
# JWT & Security
# Generate with: openssl rand -hex 32
# ===========================================
SECRET_KEY=your_super_secret_key_generate_with_openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# CORS Origins (update with your frontend URL)
# ===========================================
BACKEND_CORS_ORIGINS=["https://your-frontend.up.railway.app"]

# ===========================================
# Email (SMTP)
# For Gmail: use App Password, not regular password
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# ===========================================
# Optional: LangSmith (for debugging)
# ===========================================
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_PROJECT=your_project_name

# ===========================================
# General Settings
# ===========================================
DEFAULT_TIMEZONE=America/Sao_Paulo
MAX_AUDIO_SIZE_MB=25
SCHEDULER_CHECK_INTERVAL_SECONDS=30
LANGGRAPH_MEMORY_STORE=postgres